# Server Configuration
PORT=5000
NODE_ENV=development

# Anomaly Detection Thresholds (ms)
LATENCY_WARNING_MS=2000
LATENCY_CRITICAL_MS=4000

# Google Gemini API Key (Optional: system provides realistic intelligent heuristic fallback if not provided)
GEMINI_API_KEY=

# Optional Email Configuration (If left blank, ethereal test email is used with instant preview link)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="API Sentinel <alerts@intelligent-api-monitoring.com>"
ALERT_EMAIL_RECIPIENT=devops-oncall@example.com
AUTO_EMAIL_ON_CRITICAL=false
